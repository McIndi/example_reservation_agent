#!/usr/bin/env python3
"""Render k8s.yaml from k8s.yaml.in and provision/*.sh (the scripts Lima and Packer share).

Each provision/NN-*.sh becomes one `mode: system` entry whose script starts with the template's param:
values exported as ERA_* variables, followed by the file verbatim. `--check` exits 1 when k8s.yaml is stale.
"""
import pathlib, re, sys
ROOT = pathlib.Path(__file__).resolve().parent.parent
PARAMS = [("stability", "ERA_STABILITY"), ("release", "ERA_RELEASE"), ("version", "ERA_K8S_VERSION"),
          ("calicoVersion", "ERA_CALICO_VERSION"), ("helmVersion", "ERA_HELM_VERSION"), ("localPathVersion", "ERA_LOCAL_PATH_VERSION"),
          ("domain", "ERA_DOMAIN"), ("llmProvider", "ERA_LLM_PROVIDER"), ("llmApiBase", "ERA_LLM_API_BASE"),
          ("llmModel", "ERA_LLM_MODEL"), ("tls", "ERA_TLS"), ("kubeadmInit", "ERA_KUBEADM_INIT")]

def render():
    src = (ROOT / "k8s.yaml.in").read_text()
    entries = []
    for f in sorted((ROOT / "provision").glob("[0-9][0-9]-*.sh")):
        body = f.read_text()
        used = [e for p, e in PARAMS if "${%s" % e in body or "$%s" % e in body]
        preamble = "".join('export %s="{{.Param.%s}}"\n' % (e, p) for p, e in PARAMS if e in used)
        # keep the shebang on line 1 (Lima executes the file), then the provenance line and the exports
        shebang, _, rest = body.partition("\n")
        assert shebang.startswith("#!"), f
        lines = [shebang, "# provision/%s" % f.name] + (preamble + rest).rstrip("\n").split("\n")
        entries.append("- mode: system\n  script: |\n" + "".join("    " + l + "\n" if l.strip() else "\n" for l in lines))
    marker = re.compile(r"^provision:[^\n]*\n", re.M)
    assert len(marker.findall(src)) == 1, "k8s.yaml.in needs exactly one provision: line"
    out = marker.sub(lambda m: m.group(0) + "".join(entries), src, count=1)
    banner = ("# GENERATED by bin/render-template from k8s.yaml.in and provision/*.sh. Edit those, then run\n"
              "# `bin/render-template`; `bin/render-template --check` tells whether this file is current.\n")
    return banner + out

if __name__ == "__main__":
    new = render()
    target = ROOT / "k8s.yaml"
    if "--check" in sys.argv:
        ok = target.exists() and target.read_text() == new
        print("k8s.yaml is current" if ok else "k8s.yaml is STALE: run bin/render-template")
        sys.exit(0 if ok else 1)
    target.write_text(new)
    print("rendered k8s.yaml from k8s.yaml.in + %d provision scripts" % len(list((ROOT / "provision").glob("[0-9][0-9]-*.sh"))))
